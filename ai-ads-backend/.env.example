# AI Ads Pipeline — Backend env vars (POC stack)
# Copy this file to .env and fill in real values. Never commit .env.
# Status as of 2026-09-17: Supabase, Upstash, and ElevenLabs accounts are live.
# Google Cloud (Veo) account not created yet — see Kickoff Checklist.
# IMPORTANT: this file is committed to git — never put real keys/secrets here. Put them in .env instead.

# --- Supabase (auth + Postgres + storage) --- [ACCOUNT READY]
# Project already created and connected. Grab the remaining keys from: Settings -> API
SUPABASE_URL=https://cbjnnyfevxwktfmxdtqi.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Settings -> Database -> Connection string (use the "URI" one, pooled)
DATABASE_URL=
# Settings -> API -> JWT Settings -> JWT Secret (used to verify user sessions on the backend)
SUPABASE_JWT_SECRET=

# --- Upstash Redis (job queue via BullMQ) --- [ACCOUNT READY]
# Get these from your Upstash Redis database dashboard
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Google Cloud / Veo (video generation) --- [BLOCKED: create Google Cloud account, $300/90-day trial]
# Get from Google AI Studio (aistudio.google.com) if using the Gemini API key route
GEMINI_API_KEY=
# OR, if using Vertex AI with a service account instead of an API key:
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- ElevenLabs (voiceover / TTS) --- [ACCOUNT READY]
# Get from ElevenLabs dashboard -> Profile -> API Keys
ELEVENLABS_API_KEY=

# --- App config --- [READY: no account needed]
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Later / not needed for POC (leave blank until you move past Veo-only) ---
# RUNWAY_API_KEY=
# KLING_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET_NAME=
