# AI Ads Pipeline — Backend env vars (POC stack)
# Copy this file to .env and fill in real values. Never commit .env.
# Status as of 2026-09-18: Supabase, Upstash, ElevenLabs, and Google Cloud (Veo) accounts are all live.
# IMPORTANT: this file is committed to git — never put real keys/secrets here. Put them in .env instead.

# --- Supabase (auth + Postgres + storage) --- [ACCOUNT READY]
# Project already created and connected. Grab the remaining keys from: Settings -> API
SUPABASE_URL=https://cbjnnyfevxwktfmxdtqi.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Settings -> Database -> Connection string (use the "URI" one, pooled)
DATABASE_URL=
# Settings -> API -> JWT Settings -> JWT Secret (used to verify user sessions on the backend)
SUPABASE_JWT_SECRET=

# --- Upstash Redis (job queue via BullMQ) --- [ACCOUNT READY]
# Get these from your Upstash Redis database dashboard
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Google Cloud / Veo (video generation) --- [ACCOUNT READY]
# Get from Google AI Studio (aistudio.google.com) if using the Gemini API key route
GEMINI_API_KEY=
# OR, if using Vertex AI (now branded "Agent Platform") with a service account instead of an API key:
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_LOCATION=us-central1
# veo-2.0-generate-001 was retired — veo-3.1-lite-generate-001 is the current cheapest tier.
VEO_MODEL=veo-3.1-lite-generate-001
# Poster pipeline (image generation). Imagen (imagen-4.x) 404s on this project in every region —
# blocked at the account level. Gemini's native image output ("Nano Banana") works instead, but
# only in the "global" location for this project (404s in us-central1, same as Imagen).
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_LOCATION=global

# --- ElevenLabs (voiceover / TTS) --- [ACCOUNT BLOCKED: Free Tier API access disabled by
# ElevenLabs anti-abuse (false-positive "unusual activity" flag); requires a paid plan to lift.
# Not wired into the pipeline for now — Veo's own built-in audio is used instead.]
ELEVENLABS_API_KEY=

# --- App config --- [READY: no account needed]
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Later / not needed for POC (leave blank until you move past Veo-only) ---
# RUNWAY_API_KEY=
# KLING_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET_NAME=

# Local dev only: keeps the deployed worker from taking local jobs (leave unset in production)
# QUEUE_PREFIX=dev
